# Database (local development — copy to .env and adjust if needed)
POSTGRES_USER=smart_rental
POSTGRES_PASSWORD=smart_rental_dev
POSTGRES_DB=smart_rental
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://smart_rental:smart_rental_dev@localhost:5433/smart_rental
ADMIN_DATABASE_URL=postgresql+psycopg://smart_rental_admin:smart_rental_admin_dev@localhost:5433/smart_rental
APP_DATABASE_URL=postgresql+psycopg://smart_rental_app:smart_rental_app_dev@localhost:5433/smart_rental
SUPER_DATABASE_URL=postgresql+psycopg://smart_rental_super:smart_rental_super_dev@localhost:5433/smart_rental
SEASON_PRICE_THRESHOLD=0.01
# Anti-detection macro-pause (set ANTIBOT_BREAK_DURATION_LOW=0 to disable)
ANTIBOT_BREAK_EVERY_MIN_LOW=5
ANTIBOT_BREAK_EVERY_MIN_HIGH=10
ANTIBOT_BREAK_DURATION_LOW=20
ANTIBOT_BREAK_DURATION_HIGH=40
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Auth (homegrown magic link) ──────────────────────────────────────────────
# APP_ENV gates dev-only behaviour. In production set APP_ENV=production and
# DO NOT define DEV_TENANT_ID (it bypasses auth — see api/dependencies.py).
APP_ENV=development
# Tenant served when there is no session cookie AND APP_ENV=development.
# Leave unset in production.
DEV_TENANT_ID=
# Secret for signing session JWTs. Generate a long random value in production.
JWT_SECRET=dev-insecure-change-me
# Base URL used to build the magic link sent by email.
APP_BASE_URL=http://localhost:8000
# Transactional email (Resend). If RESEND_API_KEY is empty the magic link is
# logged to the server console instead of sent (dev mode).
RESEND_API_KEY=
RESEND_FROM=RentRadar <login@rentradar.app>
