# Database (local development — copy to .env and adjust if needed)
POSTGRES_USER=smart_rental
POSTGRES_PASSWORD=smart_rental_dev
POSTGRES_DB=smart_rental
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://smart_rental:smart_rental_dev@localhost:5433/smart_rental
ADMIN_DATABASE_URL=postgresql+psycopg://smart_rental_admin:smart_rental_admin_dev@localhost:5433/smart_rental
APP_DATABASE_URL=postgresql+psycopg://smart_rental_app:smart_rental_app_dev@localhost:5433/smart_rental
SUPER_DATABASE_URL=postgresql+psycopg://smart_rental_super:smart_rental_super_dev@localhost:5433/smart_rental
SEASON_PRICE_THRESHOLD=0.01
# Scraping period length in days (default 300; use a shorter period in dev to iterate faster)
PERIOD_DAYS=300
# Anti-detection macro-pause (set ANTIBOT_BREAK_DURATION_LOW=0 to disable)
ANTIBOT_BREAK_EVERY_MIN_LOW=5
ANTIBOT_BREAK_EVERY_MIN_HIGH=10
ANTIBOT_BREAK_DURATION_LOW=20
ANTIBOT_BREAK_DURATION_HIGH=40
GEMINI_API_KEY=
# ACRISS classification models. Pin explicit versions — never "-latest" aliases
# or "-preview" models (the classifier is calibrated; a model changing under-
# neath silently recalibrates confidences). Changing these rotates
# classifier_version and invalidates the model_classifications cache; run
# scripts/reclassify_compare.py to diff old vs new before adopting.
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
ANTHROPIC_API_KEY=

# ── Auth (homegrown email + password) ────────────────────────────────────────
# APP_ENV gates dev-only behaviour. In production set APP_ENV=production and
# DO NOT define DEV_TENANT_ID (it bypasses auth — see api/dependencies.py).
APP_ENV=development
# Tenant served when there is no session cookie AND APP_ENV=development.
# Leave unset in production.
DEV_TENANT_ID=
# Secret for signing session JWTs (30-day sessions). MUST be a long random value
# in any non-development environment. Provision users with scripts/create_tenant.py.
JWT_SECRET=dev-insecure-change-me
# ── Reserved for the future "password reset by email" flow ───────────────────
# Not used by the email+password login. Kept because login_tokens + the email
# sender are retained as the substrate for password reset (see DATA_MODEL.md).
# Base URL used to build links sent by email.
APP_BASE_URL=http://localhost:8000
# Transactional email (Resend). If RESEND_API_KEY is empty the link is logged to
# the server console instead of sent (dev mode).
RESEND_API_KEY=
RESEND_FROM=Acceso <login@example.com>
